# docker compose 环境变量示例
# 复制为 .env 后按实际环境填写：cp .env.example .env

# 业务库（与 conf.ini [db_prod] 的 name / username / password 保持一致）
POSTGRES_DB=dba
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# 已有 PG 数据卷名，先用 docker volume ls 确认，避免起出一个空库
PG_VOLUME_NAME=<existing-pg-volume-name>

# 后端配置环境：local | dev | test | prod
ENV_TYPE=prod

# 前端 nginx HTTPS：auto=证书存在才启用 443/80；on=强制启用；off=仅保留 8765 的 HTTP
NGINX_HTTPS=auto
