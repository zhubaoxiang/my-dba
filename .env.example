# docker compose 环境变量示例
# 复制为 .env 后按实际环境填写：cp .env.example .env

# 业务库（与 conf.ini [db_prod] 的 name / username / password 保持一致）
POSTGRES_DB=dba
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# PG 数据卷名：首次部署先 docker volume create <名字> 再填这里；
# 从已有部署迁移时用 docker volume ls / docker inspect 确认实际卷名
PG_VOLUME_NAME=<existing-pg-volume-name>

# 后端配置环境：local | dev | test | prod
ENV_TYPE=prod

# 前端 nginx HTTPS：auto=证书存在才启用 443；on=强制启用；off=关闭
NGINX_HTTPS=auto
# 前端对外 HTTP 端口，默认 80；如需避开占用可改为 8765 等，需在安全组放行
NGINX_HTTP_PORT=80
